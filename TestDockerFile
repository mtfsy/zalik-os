# Use a stable Ubuntu base for toolchain compatibility
FROM ubuntu:24.04

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# 1. Install system dependencies and QEMU
RUN apt-get update && apt-get install -y \
    qemu-system-riscv64 \
    gcc-riscv64-unknown-elf \
    gdb-riscv64-unknown-elf \
    binutils-riscv64-unknown-elf \
    make \
    git \
    curl \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# 2. Set the working directory for your OS source code
WORKDIR /os

# 3. (Optional) Set up a volume so you can edit code on your host
VOLUME ["/os"]

# Default command: show versions to verify installation
CMD ["sh", "-c", "qemu-system-riscv64 --version && riscv64-unknown-elf-gcc --version"]
